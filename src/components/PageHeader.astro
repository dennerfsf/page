---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="mb-10 max-w-3xl md:mb-14">
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h1 class="font-display text-4xl font-bold tracking-tight text-fg sm:text-5xl">{title}</h1>
  {description && <p class="mt-4 text-lg leading-relaxed text-muted">{description}</p>}
  <slot />
</div>

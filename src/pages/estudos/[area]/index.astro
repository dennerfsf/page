---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Icon from '../../../components/Icon.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { getStudies, type Post } from '../../../lib/content';
import { ROUTES, studyAreaPath } from '../../../lib/routes';
import { AREAS, type Area } from '../../../lib/taxonomy';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  // As quatro áreas sempre têm página, mesmo sem estudos publicados.
  return Promise.all(
    (Object.keys(AREAS) as Area[]).map(async (area) => ({ params: { area }, props: { area, posts: await getStudies(area) } })),
  );
}

interface Props { area: Area; posts: Post[] }
const { area, posts } = Astro.props;
const label = AREAS[area];
---

<BaseLayout
  title={`${label} — Estudos`}
  description={`Notas de estudo sobre ${label.toLowerCase()}.`}
  crumbs={[
    { label: 'Estudos', href: ROUTES.studies },
    { label, href: studyAreaPath(area) },
  ]}
>
  <PageHeader eyebrow="Estudos" title={label} />

  {
    posts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <BlogCard post={post} headingLevel="h2" />)}
      </div>
    ) : (
      <EmptyState text={`Os estudos de ${label.toLowerCase()} serão publicados aqui.`} />
    )
  }

  <p class="mt-10">
    <a href={withBase(ROUTES.studies)} class="inline-flex items-center gap-2 font-medium text-link hover:underline"><Icon name="arrow-left" size={16} /> Todas as áreas</a>
  </p>
</BaseLayout>

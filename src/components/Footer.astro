---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';
import { NAV, SITE, profile } from '../data/site';
import { t, type Lang } from '../i18n/ui';
import { ROUTES } from '../lib/routes';
import { withBase } from '../lib/url';

interface Props { lang?: Lang }
const { lang = 'pt-BR' } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();

// Coluna "Conteúdo": as seções do menu (exceto "Sobre") com seu primeiro nível, mais categorias e tags.
const sections = NAV.filter((item) => item.key !== 'nav.aboutMenu');
const contentLinks = [
  ...sections.flatMap((item) => [
    { label: tr(item.key), href: item.href, sub: false },
    ...(item.children ?? []).map((c) => ({ label: tr(c.key), href: c.href, sub: true })),
  ]),
  { label: tr('nav.categories'), href: ROUTES.categories, sub: false },
  { label: tr('nav.tags'), href: ROUTES.tags, sub: false },
];
const aboutLinks = NAV.find((item) => item.key === 'nav.aboutMenu')?.children ?? [];
---

<footer data-site-footer class="mt-24 border-t border-border bg-surface/60">
  <div class="container-site grid gap-10 py-14 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
    <div class="space-y-4">
      <Logo />
      <p class="max-w-sm text-sm leading-relaxed text-muted">{SITE.description}</p>
      <SocialLinks />
    </div>

    <nav aria-labelledby="footer-content">
      <h2 id="footer-content" class="mb-3 font-display text-sm font-semibold text-fg">{tr('nav.content')}</h2>
      <ul class="space-y-2 text-sm">
        {
          contentLinks.map((item) => (
            <li>
              <a class:list={['text-muted hover:text-link', item.sub && 'pl-3']} href={withBase(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-about">
      <h2 id="footer-about" class="mb-3 font-display text-sm font-semibold text-fg">{tr('nav.aboutMenu')}</h2>
      <ul class="space-y-2 text-sm">
        {
          aboutLinks.map((item) => (
            <li>
              <a class="text-muted hover:text-link" href={withBase(item.href)}>{tr(item.key)}</a>
            </li>
          ))
        }
        <li><a class="text-muted hover:text-link" href={withBase('/busca/')}>{tr('nav.search')}</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="mb-3 font-display text-sm font-semibold text-fg">Assine e acompanhe</h2>
      <ul class="space-y-2 text-sm">
        <li>
          <a class="inline-flex items-center gap-2 text-muted hover:text-link" href={withBase('/rss.xml')}>
            <Icon name="rss" size={16} /> Feed RSS: notícias e publicações
          </a>
        </li>
        {
          profile.email && (
            <li>
              <a class="inline-flex items-center gap-2 text-muted hover:text-link" href={`mailto:${profile.email}`}>
                <Icon name="mail" size={16} /> {profile.email}
              </a>
            </li>
          )
        }
        <li>
          <a class="inline-flex items-center gap-2 text-muted hover:text-link" href={withBase('/en/resume/')} hreflang="en" lang="en">
            <Icon name="globe" size={16} /> Resume in English
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="container-site flex flex-col gap-2 py-6 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.title} · {profile.name}. {tr('footer.rights')}</p>
      <p>{tr('footer.built')}</p>
    </div>
  </div>
</footer>

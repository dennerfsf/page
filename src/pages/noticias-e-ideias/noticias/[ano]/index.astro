---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import BlogCard from '../../../../components/BlogCard.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import Icon from '../../../../components/Icon.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import { getPostsBySecao, newsYears, type Post } from '../../../../lib/content';
import { ROUTES, newsYearPath, postYear } from '../../../../lib/routes';
import { withBase } from '../../../../lib/url';

export async function getStaticPaths() {
  const news = await getPostsBySecao('noticias');
  // Um ano novo nas datas das notícias gera a página automaticamente no próximo build.
  return newsYears(news).map((year) => ({
    params: { ano: String(year) },
    props: { year, posts: news.filter((p) => postYear(p) === year) },
  }));
}

interface Props { year: number; posts: Post[] }
const { year, posts } = Astro.props;
---

<BaseLayout
  title={`Notícias de ${year}`}
  description={`Notícias publicadas em ${year} sobre software, dados, computação e ciência.`}
  crumbs={[
    { label: 'Notícias e ideias', href: ROUTES.newsIdeas },
    { label: 'Notícias', href: ROUTES.news },
    { label: String(year), href: newsYearPath(year) },
  ]}
>
  <PageHeader
    eyebrow="Notícias"
    title={`Notícias de ${year}`}
    description={posts.length ? `${posts.length} ${posts.length === 1 ? 'notícia publicada' : 'notícias publicadas'} em ${year}.` : undefined}
  />

  {
    posts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <BlogCard post={post} headingLevel="h2" />)}
      </div>
    ) : (
      <EmptyState text={`Ainda não há notícias publicadas em ${year}.`} />
    )
  }

  <p class="mt-10">
    <a href={withBase(ROUTES.news)} class="inline-flex items-center gap-2 font-medium text-link hover:underline"><Icon name="arrow-left" size={16} /> Todas as notícias</a>
  </p>
</BaseLayout>

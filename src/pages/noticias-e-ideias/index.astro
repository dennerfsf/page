---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getPostsBySecao, newsYears } from '../../lib/content';
import { ROUTES, newsYearPath } from '../../lib/routes';
import { withBase } from '../../lib/url';

const news = await getPostsBySecao('noticias');
const ideas = await getPostsBySecao('publicacoes');
const years = newsYears(news);
---

<BaseLayout
  title="Notícias e ideias"
  description="Notícias e publicações (textos técnicos e de opinião) sobre software, dados, computação e ciência."
  crumbs={[{ label: 'Notícias e ideias', href: ROUTES.newsIdeas }]}
>
  <PageHeader
    eyebrow="Cero"
    title="Notícias e ideias"
    description="Notícias organizadas por ano e publicações com textos técnicos e de opinião."
  >
    <a href={withBase('/rss.xml')} class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-link hover:underline">
      <Icon name="rss" size={16} /> Assinar o feed RSS
    </a>
  </PageHeader>

  <div class="grid gap-20">
    <section aria-labelledby="noticias">
      <SectionHeading eyebrow="Por ano" title="Notícias" id="noticias" link={{ href: ROUTES.news, label: 'Todas as notícias' }} />
      <ul class="mb-6 flex flex-wrap gap-2" aria-label="Anos">
        {years.map((year) => <li><a href={withBase(newsYearPath(year))} class="chip hover:border-link hover:text-link">{year}</a></li>)}
      </ul>
      {
        news.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{news.slice(0, 3).map((p) => <BlogCard post={p} />)}</div>
        ) : (
          <EmptyState text="Ainda não há notícias publicadas." />
        )
      }
    </section>

    <section aria-labelledby="publicacoes">
      <SectionHeading eyebrow="Técnicos e de opinião" title="Publicações" id="publicacoes" link={{ href: ROUTES.ideas, label: 'Todas as publicações' }} />
      {
        ideas.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{ideas.slice(0, 3).map((p) => <BlogCard post={p} />)}</div>
        ) : (
          <EmptyState text="Ainda não há publicações." />
        )
      }
    </section>

    <nav aria-label="Outras formas de navegar" class="flex flex-wrap gap-3">
      <a href={withBase(ROUTES.categories)} class="btn btn-ghost"><Icon name="filter" size={18} /> Categorias</a>
      <a href={withBase(ROUTES.tags)} class="btn btn-ghost"><Icon name="hash" size={18} /> Tags</a>
    </nav>
  </div>
</BaseLayout>

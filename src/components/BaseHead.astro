---
import { Font } from 'astro:assets';
import { SITE, profile } from '../data/site';
import { absoluteUrl, withBase } from '../lib/url';
import '../styles/global.css';

export interface HeadProps {
  title: string;
  description?: string;
  /** Caminho em /public ou URL absoluta (ideal: PNG/JPG 1200×630). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** Grafo JSON-LD já serializado (ver lib/seo.ts). */
  jsonLd?: string;
  lang?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** Versões em outros idiomas: [{ lang: 'en', href: '/en/resume/' }] */
  alternates?: { lang: string; href: string }[];
  /** Metadados extras (ex.: citation_* para publicações científicas). */
  meta?: { name: string; content: string }[];
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  imageAlt,
  type = 'website',
  noindex = false,
  jsonLd,
  lang = 'pt-BR',
  publishedTime,
  modifiedTime,
  tags = [],
  alternates = [],
  meta = [],
} = Astro.props as HeadProps;

const isHome = Astro.url.pathname.replace(/\/+$/, '') === import.meta.env.BASE_URL.replace(/\/+$/, '');
const fullTitle = isHome ? `${profile.name} — ${profile.headline.pt}` : `${title} · ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImage = absoluteUrl(image, Astro.site);
const ogLocale = lang === 'en' ? 'en_US' : 'pt_BR';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={profile.name} />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
<link rel="manifest" href={withBase('/site.webmanifest')} />
<meta name="theme-color" content="#0B1120" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#F8FAFC" media="(prefers-color-scheme: light)" />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} — Blog`} href={withBase('/rss.xml')} />
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={absoluteUrl(a.href, Astro.site)} />)}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={isHome ? fullTitle : title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && <meta property="article:author" content={profile.name} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={isHome ? fullTitle : title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{meta.map((m) => <meta name={m.name} content={m.content} />)}

{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

<Font cssVariable="--font-inter" preload={[{ subset: 'latin', weight: '400', style: 'normal' }]} />
<Font cssVariable="--font-space-grotesk" preload={[{ subset: 'latin', weight: '700', style: 'normal' }]} />
<Font cssVariable="--font-jetbrains-mono" />

<!-- Aplica o tema antes da renderização para evitar "flash" de cor. -->
<script is:inline>
  (function () {
    var d = document.documentElement;
    d.classList.add('js');
    var t = null;
    try { t = localStorage.getItem('theme'); } catch (e) {}
    if (t !== 'light' && t !== 'dark') {
      t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    d.classList.toggle('dark', t === 'dark');
  })();
</script>

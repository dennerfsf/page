---
import Icon from './Icon.astro';
import { withBase } from '../lib/url';
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  description?: string;
  link?: { href: string; label: string };
}
const { eyebrow, title, id, description, link } = Astro.props;
---

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
  <div class="max-w-2xl">
    {eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
    <h2 id={id} class="font-display text-3xl font-bold tracking-tight text-fg sm:text-4xl">{title}</h2>
    {description && <p class="mt-3 text-muted">{description}</p>}
  </div>
  {
    link && (
      <a href={withBase(link.href)} class="group inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-link">
        {link.label}
        <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-0.5" />
      </a>
    )
  }
</div>

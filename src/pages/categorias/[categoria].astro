---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostsBySection from '../../components/PostsBySection.astro';
import { getPosts, type Post } from '../../lib/content';
import { ROUTES, categoryPath } from '../../lib/routes';
import { BLOG_CATEGORIES, slugify } from '../../lib/taxonomy';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Só gera páginas para categorias com textos (evita páginas vazias no sitemap).
  return BLOG_CATEGORIES.map((category) => ({
    params: { categoria: slugify(category) },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  })).filter((path) => path.props.posts.length > 0);
}

interface Props { category: string; posts: Post[] }
const { category, posts } = Astro.props;
---

<BaseLayout
  title={`${category} — Categorias`}
  description={`Notícias, publicações e estudos sobre ${category}.`}
  crumbs={[
    { label: 'Categorias', href: ROUTES.categories },
    { label: category, href: categoryPath(category) },
  ]}
>
  <PageHeader eyebrow="Categoria" title={category} description={`${posts.length} ${posts.length === 1 ? 'texto' : 'textos'} nesta categoria.`} />
  <PostsBySection posts={posts} />
  <p class="mt-10"><a class="link" href={withBase(ROUTES.categories)}>Todas as categorias</a></p>
</BaseLayout>

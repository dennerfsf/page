---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoBadge from '../../components/DemoBadge.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import Icon from '../../components/Icon.astro';
import { formatAuthors, getPublications, type Publication } from '../../lib/content';
import { scholarlyArticleLd } from '../../lib/seo';
import { ROUTES, articlePath } from '../../lib/routes';
import { PUBLICATION_TYPES, slugify } from '../../lib/taxonomy';
import { absoluteUrl, withBase } from '../../lib/url';

export async function getStaticPaths() {
  const pubs = await getPublications();
  return pubs.map((pub) => ({ params: { id: pub.id }, props: { pub } }));
}

interface Props { pub: Publication }
const { pub } = Astro.props;
const { title, authors, year, venue, doi, url, pdf, keywords, type, language, demo } = pub.data;
const { Content } = await render(pub);
const pageUrl = absoluteUrl(articlePath(pub), Astro.site);
const abstract = (pub.body ?? '').replace(/[#*_`>]/g, '').replace(/\s+/g, ' ').trim();

// Metadados lidos pelo Google Scholar e gerenciadores de referência (Zotero, Mendeley).
const isJournal = type === 'artigo-periodico';
const meta = [
  { name: 'citation_title', content: title },
  ...authors.map((a) => ({ name: 'citation_author', content: a })),
  { name: 'citation_publication_date', content: String(year) },
  { name: isJournal ? 'citation_journal_title' : 'citation_conference_title', content: venue },
  { name: 'citation_language', content: language },
  ...(doi ? [{ name: 'citation_doi', content: doi }] : []),
  ...(pdf ? [{ name: 'citation_pdf_url', content: absoluteUrl(pdf, Astro.site) }] : []),
  ...(keywords.length ? [{ name: 'citation_keywords', content: keywords.join('; ') }] : []),
];

const bibKey = `${slugify(authors[0].split(' ').at(-1) ?? 'autor')}${year}`;
const bibtex = [
  `@${isJournal ? 'article' : type === 'artigo-evento' ? 'inproceedings' : 'misc'}{${bibKey},`,
  `  title = {${title}},`,
  `  author = {${authors.join(' and ')}},`,
  `  ${isJournal ? 'journal' : type === 'artigo-evento' ? 'booktitle' : 'howpublished'} = {${venue}},`,
  `  year = {${year}},`,
  ...(doi ? [`  doi = {${doi}},`] : []),
  ...(url ? [`  url = {${url}},`] : []),
  '}',
].join('\n');
---

<BaseLayout
  title={title}
  description={abstract.slice(0, 160) || `${PUBLICATION_TYPES[type]} — ${venue}, ${year}.`}
  type="article"
  meta={meta}
  crumbs={[
    { label: 'Artigos', href: ROUTES.articles },
    { label: title, href: articlePath(pub) },
  ]}
  schema={[scholarlyArticleLd({ title, authors, year, venue, doi, url: pageUrl, keywords, abstract })]}
>
  <article class="mx-auto max-w-3xl">
    <header class="mb-10">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <span class="eyebrow">{PUBLICATION_TYPES[type]} · {year}</span>
        <DemoBadge show={demo} />
      </div>
      <h1 class="font-display text-3xl font-bold leading-tight tracking-tight text-fg sm:text-4xl">{title}</h1>
      <p class="mt-4 text-lg text-fg-soft">{formatAuthors(authors)}</p>
      <p class="mt-1 italic text-muted">{venue}</p>

      <div class="mt-6 flex flex-wrap gap-3">
        {
          doi && (
            <a href={`https://doi.org/${doi}`} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
              <Icon name="link" size={18} /> DOI {doi}
            </a>
          )
        }
        {
          url && (
            <a href={url} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
              <Icon name="external" size={18} /> Acessar publicação
            </a>
          )
        }
        {
          pdf && (
            <a href={withBase(pdf)} class="btn btn-ghost" download>
              <Icon name="download" size={18} /> Baixar PDF
            </a>
          )
        }
      </div>
    </header>

    {demo && <div class="mb-8"><DemoNotice text="Publicação demonstrativa: título, autoria e veículo são fictícios e servem apenas para validar o layout. Substitua por publicações reais." /></div>}

    <section aria-labelledby="resumo">
      <h2 id="resumo" class="mb-3 font-display text-xl font-semibold text-fg">Resumo</h2>
      <div class="prose prose-site max-w-none">
        <Content />
      </div>
    </section>

    {
      keywords.length > 0 && (
        <section aria-labelledby="palavras" class="mt-8">
          <h2 id="palavras" class="mb-3 font-display text-xl font-semibold text-fg">Palavras-chave</h2>
          <ul class="flex flex-wrap gap-2">{keywords.map((k) => <li class="chip">{k}</li>)}</ul>
        </section>
      )
    }

    <section aria-labelledby="citar" class="mt-10" data-pagefind-ignore>
      <h2 id="citar" class="mb-3 font-display text-xl font-semibold text-fg">Como citar (BibTeX)</h2>
      <div class="relative">
        <pre class="overflow-x-auto rounded-xl border border-border bg-surface p-4 font-mono text-sm text-fg-soft"><code>{bibtex}</code></pre>
        <button type="button" data-copy={bibtex} data-copied="Copiado!" class="no-print absolute right-2 top-2 inline-flex min-h-9 items-center gap-1.5 rounded-lg border border-border bg-bg px-2.5 text-xs text-muted hover:text-link">
          <Icon name="copy" size={14} /> Copiar <span data-copy-status role="status" aria-live="polite" class="text-accent"></span>
        </button>
      </div>
    </section>

    <p class="mt-12">
      <a href={withBase(ROUTES.articles)} class="inline-flex items-center gap-2 font-medium text-link hover:underline"><Icon name="arrow-left" size={16} /> Todos os artigos</a>
    </p>
  </article>
</BaseLayout>

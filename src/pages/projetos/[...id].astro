---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cover from '../../components/Cover.astro';
import DemoBadge from '../../components/DemoBadge.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { formatShortDate } from '../../i18n/format';
import { getProjects, type Project } from '../../lib/content';
import { PROJECT_STATUS, slugify } from '../../lib/taxonomy';
import { absoluteUrl, withBase } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project, all: projects } }));
}

interface Props { project: Project; all: Project[] }
const { project, all } = Astro.props;
const { title, summary, category, extraCategories, technologies, status, date, endDate, visibility, role, repo, demoUrl, cover, coverAlt, demo } = project.data;
const { Content } = await render(project);
const isPrivate = visibility === 'private';
const others = all.filter((p) => p.id !== project.id && (p.data.category === category || p.data.extraCategories.includes(category))).slice(0, 3);

const facts = [
  { label: 'Categoria', value: [category, ...extraCategories].join(', ') },
  { label: 'Status', value: PROJECT_STATUS[status] },
  { label: 'Período', value: `${formatShortDate(date)}${endDate ? ` — ${formatShortDate(endDate)}` : status === 'em-andamento' ? ' — atual' : ''}` },
  ...(role ? [{ label: 'Papel', value: role }] : []),
];
---

<BaseLayout
  title={title}
  description={summary}
  crumbs={[
    { label: 'Projetos', href: '/projetos/' },
    { label: title, href: `/projetos/${project.id}/` },
  ]}
  schema={[
    {
      '@type': 'CreativeWork',
      name: title,
      description: summary,
      url: absoluteUrl(`/projetos/${project.id}/`, Astro.site),
      dateCreated: date.toISOString(),
      keywords: technologies.join(', '),
      genre: category,
      ...(repo && !isPrivate ? { codeRepository: repo } : {}),
    },
  ]}
>
  <article>
    <header class="mb-10 grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <a class="eyebrow hover:underline" href={withBase(`/projetos/?categoria=${slugify(category)}`)}>{category}</a>
          {isPrivate && <span class="chip"><Icon name="lock" size={13} /> Projeto confidencial</span>}
          <DemoBadge show={demo} />
        </div>
        <h1 class="font-display text-4xl font-bold leading-tight tracking-tight text-fg sm:text-5xl">{title}</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">{summary}</p>
        {
          !isPrivate && (repo || demoUrl) && (
            <div class="mt-7 flex flex-wrap gap-3">
              {repo && (
                <a href={repo} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
                  <Icon name="github" size={18} /> Repositório
                </a>
              )}
              {demoUrl && (
                <a href={demoUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
                  <Icon name="external" size={18} /> Demonstração
                </a>
              )}
            </div>
          )
        }
      </div>
      <Cover image={cover} alt={coverAlt} seed={project.id} label={category} eager class="rounded-2xl border border-border" sizes="(min-width: 1024px) 40vw, 100vw" />
    </header>

    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div class="min-w-0 space-y-8">
        {demo && <DemoNotice text="Projeto demonstrativo, criado para validar o layout. Substitua por um projeto real ou remova o arquivo." />}
        {
          isPrivate && (
            <div role="note" class="flex items-start gap-3 rounded-xl border border-border bg-surface-2 px-4 py-3 text-sm text-fg-soft">
              <Icon name="lock" size={18} class="mt-0.5 shrink-0 text-accent" />
              <p>
                Projeto desenvolvido em ambiente confidencial. São apresentados apenas contexto, abordagem e resultados autorizados para divulgação —
                sem dados internos, credenciais ou detalhes sensíveis de arquitetura.
              </p>
            </div>
          )
        }
        <div class="prose prose-site max-w-none">
          <Content />
        </div>
      </div>

      <aside class="space-y-6">
        <div class="card p-5">
          <h2 class="mb-4 font-display text-sm font-semibold uppercase tracking-wide text-fg">Ficha do projeto</h2>
          <dl class="space-y-3 text-sm">
            {
              facts.map((f) => (
                <div>
                  <dt class="text-muted">{f.label}</dt>
                  <dd class="font-medium text-fg">{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
        {
          technologies.length > 0 && (
            <div class="card p-5">
              <h2 class="mb-4 font-display text-sm font-semibold uppercase tracking-wide text-fg">Tecnologias</h2>
              <ul class="flex flex-wrap gap-1.5">
                {technologies.map((tech) => <li class="chip !text-xs">{tech}</li>)}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </article>

  {
    others.length > 0 && (
      <section aria-labelledby="outros" class="mt-20" data-pagefind-ignore>
        <h2 id="outros" class="mb-6 font-display text-2xl font-bold text-fg">Outros projetos em {category}</h2>
        <div class="grid gap-6 md:grid-cols-3">
          {others.map((p) => <ProjectCard project={p} />)}
        </div>
      </section>
    )
  }
  <p class="mt-12">
    <a href={withBase('/projetos/')} class="inline-flex items-center gap-2 font-medium text-link hover:underline"><Icon name="arrow-left" size={16} /> Todos os projetos</a>
  </p>
</BaseLayout>

---
import Cover from './Cover.astro';
import DemoBadge from './DemoBadge.astro';
import Icon from './Icon.astro';
import { formatShortDate } from '../i18n/format';
import type { Project } from '../lib/content';
import { PROJECT_STATUS, slugify } from '../lib/taxonomy';
import { withBase } from '../lib/url';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
  filterable?: boolean;
}
const { project, headingLevel = 'h3', filterable = false } = Astro.props;
const { title, summary, category, extraCategories, technologies, status, date, visibility, cover, coverAlt, demo } = project.data;
const href = withBase(`/projetos/${project.id}/`);
const H = headingLevel;
const cats = [category, ...extraCategories].map(slugify).join('|');
---

<article
  class="card card-hover group relative flex h-full flex-col overflow-hidden"
  data-project
  data-categories={filterable ? cats : undefined}
>
  <Cover image={cover} alt={coverAlt} seed={project.id} label={category}>
    {
      visibility === 'private' && (
        <span class="absolute right-3 top-3 inline-flex items-center gap-1.5 rounded-full bg-black/60 px-2.5 py-1 text-xs font-medium text-white backdrop-blur">
          <Icon name="lock" size={13} /> Confidencial
        </span>
      )
    }
  </Cover>
  <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="font-semibold uppercase tracking-wide text-accent">{category}</span>
      <DemoBadge show={demo} />
    </div>
    <H class="font-display text-xl font-semibold leading-snug text-fg">
      <a href={href} class="after:absolute after:inset-0 after:content-[''] group-hover:text-link">{title}</a>
    </H>
    <p class="line-clamp-3 text-sm leading-relaxed text-muted">{summary}</p>
    <ul class="flex flex-wrap gap-1.5" aria-label="Tecnologias">
      {technologies.slice(0, 5).map((tech) => <li class="chip !text-xs">{tech}</li>)}
    </ul>
    <div class="mt-auto flex items-center justify-between pt-2 text-xs text-muted">
      <span>{PROJECT_STATUS[status]} · <time datetime={date.toISOString()}>{formatShortDate(date)}</time></span>
      <Icon name="arrow-right" size={16} class="text-link transition-transform group-hover:translate-x-1" />
    </div>
  </div>
</article>

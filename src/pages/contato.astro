---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import { profile, socialLinks } from '../data/site';
import { l } from '../i18n/format';

const links = socialLinks();
---

<BaseLayout
  title="Contato"
  description={`Entre em contato com ${profile.name} por e-mail ou redes profissionais.`}
  crumbs={[{ label: 'Contato', href: '/contato/' }]}
  schema={[{ '@type': 'ContactPage', name: 'Contato', about: { '@type': 'Person', name: profile.name } }]}
>
  <PageHeader eyebrow="Contato" title="Vamos conversar" description={l(profile.availability)} />

  <div class="grid gap-6 lg:grid-cols-[1.2fr_1fr]">
    <section aria-labelledby="email" class="card bg-grid p-8 sm:p-10">
      <span class="mb-5 grid size-12 place-items-center rounded-xl bg-primary text-on-primary"><Icon name="mail" size={22} /></span>
      <h2 id="email" class="font-display text-2xl font-bold text-fg">E-mail profissional</h2>
      {
        profile.email ? (
          <>
            <p class="mt-2 text-muted">A forma mais direta de falar comigo. Respondo assim que possível.</p>
            <a href={`mailto:${profile.email}`} class="btn btn-primary mt-6 break-all">
              {profile.email}
            </a>
          </>
        ) : (
          <p class="mt-3 rounded-xl border border-dashed border-border-strong p-4 text-sm text-muted">
            O e-mail profissional ainda não foi configurado. Preencha o campo <code class="font-mono">email</code> em
            <code class="font-mono">src/data/profile.json</code> para exibir aqui um link <code class="font-mono">mailto:</code>.
          </p>
        )
      }
      {
        profile.location && (
          <p class="mt-8 inline-flex items-center gap-2 text-sm text-muted">
            <Icon name="map-pin" size={16} /> {profile.location}
          </p>
        )
      }
    </section>

    <section aria-labelledby="redes" class="card p-8 sm:p-10">
      <h2 id="redes" class="mb-6 font-display text-2xl font-bold text-fg">Redes profissionais</h2>
      <ul class="grid gap-3">
        {
          links.map((s) => (
            <li>
              <a
                href={s.url}
                target="_blank"
                rel="me noopener noreferrer"
                class="group flex min-h-14 items-center gap-4 rounded-xl border border-border px-4 py-3 transition-colors hover:border-link"
              >
                <span class="grid size-10 place-items-center rounded-lg bg-surface-2 text-fg group-hover:text-link"><Icon name={s.icon} /></span>
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold text-fg">{s.label}</span>
                  <span class="block truncate text-sm text-muted">{s.url.replace(/^https?:\/\/(www\.)?/, '')}</span>
                </span>
                <Icon name="external" size={16} class="text-muted group-hover:text-link" />
                <span class="sr-only">(abre em nova aba)</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-xs text-muted">Perfis adicionais (LinkedIn, ORCID, Google Scholar, ResearchGate, Lattes) aparecem aqui ao serem preenchidos em <code class="font-mono">profile.json</code>.</p>
    </section>
  </div>
</BaseLayout>

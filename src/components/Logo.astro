---
import { profile } from '../data/site';
import { withBase } from '../lib/url';
interface Props { class?: string }
---

<a href={withBase('/')} class:list={['group inline-flex items-center gap-2.5 rounded-lg', Astro.props.class]}>
  <span
    class="grid size-9 place-items-center rounded-xl bg-gradient-to-br from-primary to-accent-strong font-display text-sm font-bold text-on-primary shadow-lg shadow-primary/20 transition-transform group-hover:rotate-[-4deg]"
    aria-hidden="true">{profile.initials}</span
  >
  <span class="font-display text-base font-semibold tracking-tight text-fg">{profile.name}</span>
</a>

{
  "name": "denner-ferreira-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Portfólio profissional, currículo, produção científica e blog — site estático para GitHub Pages.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/generate-cv-pdf.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "cv:pdf": "node scripts/generate-cv-pdf.mjs",
    "images": "node scripts/generate-images.mjs",
    "test:links": "node scripts/check-links.mjs",
    "validate": "npm run check && npm run build && npm run test:links && npm run test:e2e",
    "astro": "astro",
    "test:e2e": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.7",
    "mermaid": "^12.3.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "pagefind": "^1.6.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3"
  }
}

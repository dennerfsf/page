---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Página não encontrada" description="A página procurada não existe ou foi movida." noindex searchable={false}>
  <section class="mx-auto max-w-xl py-16 text-center">
    <p class="text-gradient font-display text-8xl font-bold">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-fg">Página não encontrada</h1>
    <p class="mt-3 text-muted">O endereço pode ter mudado ou a página foi removida.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={withBase('/')} class="btn btn-primary"><Icon name="arrow-left" size={18} /> Voltar ao início</a>
      <a href={withBase('/busca/')} class="btn btn-ghost"><Icon name="search" size={18} /> Buscar no site</a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Icon from '../../../components/Icon.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { getPostsBySecao, newsYears } from '../../../lib/content';
import { ROUTES, newsYearPath, postYear } from '../../../lib/routes';
import { withBase } from '../../../lib/url';

const news = await getPostsBySecao('noticias');
const years = newsYears(news).map((year) => ({ year, items: news.filter((p) => postYear(p) === year) }));
---

<BaseLayout
  title="Notícias — Notícias e ideias"
  description="Notícias sobre software, dados, computação e ciência, organizadas por ano."
  crumbs={[
    { label: 'Notícias e ideias', href: ROUTES.newsIdeas },
    { label: 'Notícias', href: ROUTES.news },
  ]}
>
  <PageHeader eyebrow="Notícias e ideias" title="Notícias" description="Notícias organizadas por ano, da mais recente para a mais antiga.">
    <a href={withBase('/rss.xml')} class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-link hover:underline">
      <Icon name="rss" size={16} /> Assinar o feed RSS
    </a>
  </PageHeader>

  <nav aria-label="Anos" class="no-print mb-12">
    <ul class="flex flex-wrap gap-2">
      {years.map(({ year, items }) => (
        <li><a href={withBase(newsYearPath(year))} class="chip hover:border-link hover:text-link">{year} <span class="opacity-70">({items.length})</span></a></li>
      ))}
    </ul>
  </nav>

  <div class="grid gap-16">
    {
      years.map(({ year, items }) => (
        <section aria-labelledby={`ano-${year}`} data-news-year={year}>
          <div class="mb-6 flex items-end justify-between gap-4">
            <h2 id={`ano-${year}`} class="font-display text-3xl font-bold text-fg">{year}</h2>
            <a href={withBase(newsYearPath(year))} class="inline-flex items-center gap-1.5 text-sm font-semibold text-link hover:underline">
              Notícias de {year} <Icon name="arrow-right" size={16} />
            </a>
          </div>
          {items.length > 0 ? (
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((post) => <BlogCard post={post} headingLevel="h3" />)}
            </div>
          ) : (
            <EmptyState text={`Ainda não há notícias publicadas em ${year}.`} />
          )}
        </section>
      ))
    }
  </div>
</BaseLayout>

---
/**
 * Capa de artigo/projeto. Com imagem: otimizada pelo Astro (WebP, lazy loading, dimensões fixas → sem CLS).
 * Sem imagem: arte geométrica gerada a partir do título, para manter a consistência visual.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt?: string;
  seed: string;
  label?: string;
  class?: string;
  eager?: boolean;
  widths?: number[];
  sizes?: string;
}
const { image, alt = '', seed, label, class: className, eager = false, widths = [480, 800, 1200], sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' } = Astro.props;

// Gera uma variação estável a partir do texto.
let h = 0;
for (const ch of seed) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const hue = [173, 168, 178, 163, 183][h % 5];
const rot = (h % 60) - 30;
const nodes = Array.from({ length: 7 }, (_, i) => {
  const v = (h >> (i * 3)) & 0xff;
  return { x: 40 + ((v * 37 + i * 97) % 520), y: 30 + ((v * 53 + i * 61) % 240), r: 3 + (v % 5) };
});
---

<div class:list={['relative aspect-[16/9] overflow-hidden bg-surface-2', className]}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={widths}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="size-full object-cover"
      />
    ) : (
      <svg viewBox="0 0 600 338" class="size-full" role="presentation" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id={`g-${h}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color={`hsl(${hue} 96% 16%)`} />
            <stop offset="1" stop-color={`hsl(${hue - 8} 98% 9%)`} />
          </linearGradient>
          <pattern id={`p-${h}`} width="30" height="30" patternUnits="userSpaceOnUse">
            <path d="M30 0H0V30" fill="none" stroke="rgba(255,239,179,.08)" />
          </pattern>
        </defs>
        <rect width="600" height="338" fill={`url(#g-${h})`} />
        <rect width="600" height="338" fill={`url(#p-${h})`} />
        <g transform={`rotate(${rot} 300 169)`} opacity=".55">
          <circle cx="300" cy="169" r="120" fill="none" stroke="#E6C55A" stroke-width="1" stroke-dasharray="4 6" />
          <circle cx="300" cy="169" r="70" fill="none" stroke="#FFEFB3" stroke-width="1" />
        </g>
        <g stroke="rgba(255,239,179,.45)" stroke-width="1">
          {nodes.slice(1).map((n, i) => <line x1={nodes[i].x} y1={nodes[i].y} x2={n.x} y2={n.y} />)}
        </g>
        {nodes.map((n) => <circle cx={n.x} cy={n.y} r={n.r} fill="#FFEFB3" />)}
        {label && (
          <text x="28" y="310" fill="rgba(255,239,179,.9)" font-family="ui-monospace, monospace" font-size="15" letter-spacing="2">
            {label.toUpperCase()}
          </text>
        )}
      </svg>
    )
  }
  <slot />
</div>

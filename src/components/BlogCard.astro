---
import Cover from './Cover.astro';
import DemoBadge from './DemoBadge.astro';
import Icon from './Icon.astro';
import { formatDate } from '../i18n/format';
import { readingTime, type Post } from '../lib/content';
import { slugify } from '../lib/taxonomy';
import { postPath } from '../lib/routes';
import { withBase } from '../lib/url';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
  /** Adiciona atributos usados pelos filtros do blog. */
  filterable?: boolean;
}
const { post, headingLevel = 'h3', eager = false, filterable = false } = Astro.props;
const { title, description, date, category, tags, cover, coverAlt, demo, featured } = post.data;
const href = withBase(postPath(post));
const minutes = readingTime(post.body);
const H = headingLevel;
---

<article
  class="card card-hover group relative flex h-full flex-col overflow-hidden"
  data-post
  data-url={filterable ? href : undefined}
  data-title={filterable ? `${title} ${description}`.toLowerCase() : undefined}
  data-category={filterable ? slugify(category) : undefined}
  data-tags={filterable ? tags.map(slugify).join('|') : undefined}
  data-date={filterable ? date.toISOString() : undefined}
>
  <Cover image={cover} alt={coverAlt} seed={post.id} label={category} eager={eager} />
  <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
    <div class="flex flex-wrap items-center gap-2 text-xs">
      <span class="font-semibold uppercase tracking-wide text-accent">{category}</span>
      {featured && <span class="chip !py-0 !text-[0.6875rem]">Destaque</span>}
      <DemoBadge show={demo} />
    </div>
    <H class="font-display text-xl font-semibold leading-snug text-fg">
      <a href={href} class="after:absolute after:inset-0 after:content-[''] group-hover:text-link">{title}</a>
    </H>
    <p class="line-clamp-3 text-sm leading-relaxed text-muted">{description}</p>
    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-2 text-xs text-muted">
      <span class="inline-flex items-center gap-1.5"><Icon name="calendar" size={14} /><time datetime={date.toISOString()}>{formatDate(date)}</time></span>
      <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={14} />{minutes} min de leitura</span>
    </div>
  </div>
</article>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import Cover from '../../../components/Cover.astro';
import DemoBadge from '../../../components/DemoBadge.astro';
import Icon from '../../../components/Icon.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { formatDate } from '../../../i18n/format';
import { getPostsBySecao, readingTime, tagIndex } from '../../../lib/content';
import { ROUTES, categoryPath, postPath } from '../../../lib/routes';
import { BLOG_CATEGORIES, slugify } from '../../../lib/taxonomy';
import { withBase } from '../../../lib/url';

const posts = await getPostsBySecao('publicacoes');
const highlight = posts.find((p) => p.data.featured) ?? posts[0];
const tags = tagIndex(posts);
const usedCategories = BLOG_CATEGORIES.filter((c) => posts.some((p) => p.data.category === c));
---

<BaseLayout
  title="Publicações — Notícias e ideias"
  description="Textos técnicos e de opinião sobre desenvolvimento de software, dados, computação e tecnologia."
  crumbs={[
    { label: 'Notícias e ideias', href: ROUTES.newsIdeas },
    { label: 'Publicações', href: ROUTES.ideas },
  ]}
>
  <PageHeader
    eyebrow="Notícias e ideias"
    title="Publicações"
    description="Textos técnicos e de opinião sobre desenvolvimento de software, dados, computação e tecnologia."
  >
    <a href={withBase('/rss.xml')} class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-link hover:underline">
      <Icon name="rss" size={16} /> Assinar o feed RSS
    </a>
  </PageHeader>

  {
    highlight && (
      <section aria-labelledby="destaque" class="mb-16">
        <h2 id="destaque" class="sr-only">Publicação em destaque</h2>
        <article class="card card-hover group relative grid overflow-hidden md:grid-cols-2">
          <Cover image={highlight.data.cover} alt={highlight.data.coverAlt} seed={highlight.id} label={highlight.data.category} eager class="md:aspect-auto md:h-full" sizes="(min-width: 768px) 50vw, 100vw" />
          <div class="flex flex-col justify-center gap-4 p-6 sm:p-10">
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="chip !border-transparent !bg-primary !text-on-primary">Mais recente em destaque</span>
              <span class="font-semibold uppercase tracking-wide text-accent">{highlight.data.category}</span>
              <DemoBadge show={highlight.data.demo} />
            </div>
            <h3 class="font-display text-2xl font-bold leading-tight text-fg sm:text-3xl">
              <a href={withBase(postPath(highlight))}class="after:absolute after:inset-0 after:content-[''] group-hover:text-link">{highlight.data.title}</a>
            </h3>
            <p class="text-muted">{highlight.data.description}</p>
            <p class="text-sm text-muted">
              <time datetime={highlight.data.date.toISOString()}>{formatDate(highlight.data.date)}</time> · {readingTime(highlight.body)} min de leitura
            </p>
          </div>
        </article>
      </section>
    )
  }

  {posts.length === 0 && <p class="card p-8 text-center text-muted" data-section-empty>Em breve: ainda não há publicações.</p>}

  <section aria-labelledby="todos" data-blog-filter hidden={posts.length === 0}>
    <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <h2 id="todos" class="font-display text-2xl font-bold text-fg">Todas as publicações</h2>
      <p class="text-sm text-muted" role="status" aria-live="polite" data-count>{posts.length} publicações</p>
    </div>

    <form class="card no-print mb-8 grid gap-4 p-4 sm:p-5 md:grid-cols-[1fr_14rem_11rem]" role="search" data-filter-form onsubmit="return false">
      <div>
        <label for="q" class="mb-1.5 block text-sm font-medium text-fg">Buscar no título e no conteúdo</label>
        <div class="relative">
          <Icon name="search" size={18} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted" />
          <input id="q" name="q" type="search" autocomplete="off" placeholder="Ex.: governança, LLM, pipeline…" class="h-11 w-full rounded-xl border border-border-strong bg-bg pl-10 pr-3 text-fg placeholder:text-muted focus:border-link focus:outline-none" />
        </div>
      </div>
      <div>
        <label for="categoria" class="mb-1.5 block text-sm font-medium text-fg">Categoria</label>
        <select id="categoria" name="categoria" class="h-11 w-full rounded-xl border border-border-strong bg-bg px-3 text-fg focus:border-link focus:outline-none">
          <option value="">Todas</option>
          {usedCategories.map((c) => <option value={slugify(c)}>{c}</option>)}
        </select>
      </div>
      <div>
        <label for="ordem" class="mb-1.5 block text-sm font-medium text-fg">Ordenar</label>
        <select id="ordem" name="ordem" class="h-11 w-full rounded-xl border border-border-strong bg-bg px-3 text-fg focus:border-link focus:outline-none">
          <option value="desc">Mais recentes</option>
          <option value="asc">Mais antigas</option>
        </select>
      </div>
      <fieldset class="md:col-span-3">
        <legend class="mb-2 text-sm font-medium text-fg">Tags</legend>
        <div class="flex flex-wrap gap-2">
          {
            tags.map((tg) => (
              <button type="button" class="chip cursor-pointer hover:border-link aria-pressed:border-transparent aria-pressed:bg-primary aria-pressed:text-on-primary" aria-pressed="false" data-tag={tg.slug}>
                {tg.tag} <span class="opacity-70 in-aria-pressed:opacity-100">({tg.count})</span>
              </button>
            ))
          }
        </div>
      </fieldset>
      <div class="md:col-span-3">
        <button type="reset" class="text-sm font-medium text-link hover:underline" data-reset>Limpar filtros</button>
      </div>
    </form>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-list>
      {posts.map((post, i) => <BlogCard post={post} headingLevel="h3" filterable eager={i < 3 && !highlight} />)}
    </div>
    <p class="card hidden p-8 text-center text-muted" data-empty>Nenhuma publicação encontrada com esses filtros.</p>
  </section>

  <nav aria-labelledby="cats" class="mt-16" hidden={usedCategories.length === 0}>
    <h2 id="cats" class="mb-4 font-display text-xl font-semibold text-fg">Navegar por categoria</h2>
    <ul class="flex flex-wrap gap-2">
      {
        usedCategories.map((c) => {
          const n = posts.filter((p) => p.data.category === c).length;
          return (
            <li>
              <a href={withBase(categoryPath(c))} class="chip hover:border-link hover:text-link">
                {c} <span class="opacity-70">({n})</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</BaseLayout>

<script>
  import { searchContent } from '../../../scripts/pagefind';
  import { ROUTES } from '../../../lib/routes';

  const root = document.querySelector<HTMLElement>('[data-blog-filter]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-filter-form]')!;
    const q = form.querySelector<HTMLInputElement>('#q')!;
    const cat = form.querySelector<HTMLSelectElement>('#categoria')!;
    const order = form.querySelector<HTMLSelectElement>('#ordem')!;
    const tagBtns = [...form.querySelectorAll<HTMLButtonElement>('[data-tag]')];
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const cards = [...list.querySelectorAll<HTMLElement>('[data-post]')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    let contentHits = new Set<string>();
    let timer: number | undefined;

    const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();

    // Estado inicial a partir da URL (?q=&categoria=&tag=&ordem=)
    const params = new URLSearchParams(location.search);
    q.value = params.get('q') ?? '';
    cat.value = params.get('categoria') ?? '';
    order.value = params.get('ordem') === 'asc' ? 'asc' : 'desc';
    const initialTags = new Set((params.get('tag') ?? '').split(',').filter(Boolean));
    tagBtns.forEach((b) => b.setAttribute('aria-pressed', String(initialTags.has(b.dataset.tag!))));

    function apply() {
      const term = norm(q.value.trim());
      const selTags = tagBtns.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.tag!);
      let visible = 0;
      const sorted = cards.slice().sort((a, b) => {
        const d = (a.dataset.date ?? '').localeCompare(b.dataset.date ?? '');
        return order.value === 'asc' ? d : -d;
      });
      for (const card of sorted) {
        const tags = (card.dataset.tags ?? '').split('|');
        const matchText = !term || norm(card.dataset.title ?? '').includes(term) || tags.some((t) => t.includes(term.replace(/\s+/g, '-'))) || contentHits.has(card.dataset.url ?? '');
        const matchCat = !cat.value || card.dataset.category === cat.value;
        const matchTags = selTags.every((t) => tags.includes(t));
        const show = matchText && matchCat && matchTags;
        card.hidden = !show;
        if (show) visible++;
        list.appendChild(card);
      }
      count.textContent = `${visible} ${visible === 1 ? 'publicação' : 'publicações'}`;
      empty.classList.toggle('hidden', visible > 0);

      const next = new URLSearchParams();
      if (q.value.trim()) next.set('q', q.value.trim());
      if (cat.value) next.set('categoria', cat.value);
      if (selTags.length) next.set('tag', selTags.join(','));
      if (order.value === 'asc') next.set('ordem', 'asc');
      const qs = next.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    async function updateContentHits() {
      const term = q.value.trim();
      contentHits = term.length >= 3 ? new Set(await searchContent(term, ROUTES.ideas)) : new Set();
      apply();
    }

    q.addEventListener('input', () => {
      apply();
      window.clearTimeout(timer);
      timer = window.setTimeout(updateContentHits, 250);
    });
    cat.addEventListener('change', apply);
    order.addEventListener('change', apply);
    tagBtns.forEach((b) =>
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
        apply();
      }),
    );
    form.addEventListener('reset', () => {
      setTimeout(() => {
        tagBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        contentHits = new Set();
        apply();
      });
    });

    apply();
    if (q.value) updateContentHits();
  }
</script>

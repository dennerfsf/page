---
import LogoMark from './LogoMark.astro';
import { SITE } from '../data/site';
import { withBase } from '../lib/url';
interface Props { class?: string }
---

<a href={withBase('/')} class:list={['group inline-flex items-center gap-2.5 rounded-lg', Astro.props.class]}>
  <LogoMark class="size-8 text-fg transition-transform group-hover:rotate-[-4deg]" />
  <span class="font-display text-base font-semibold tracking-tight text-fg">{SITE.title}</span>
</a>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { getPosts, type Post } from '../../../lib/content';
import { BLOG_CATEGORIES, slugify } from '../../../lib/taxonomy';
import { withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Só gera páginas para categorias com publicações (evita páginas vazias no sitemap).
  return BLOG_CATEGORIES.map((category) => ({
    params: { categoria: slugify(category) },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  })).filter((path) => path.props.posts.length > 0);
}

interface Props { category: string; posts: Post[] }
const { category, posts } = Astro.props;
---

<BaseLayout
  title={`${category} — Blog`}
  description={`Artigos e notícias sobre ${category}.`}
  crumbs={[
    { label: 'Blog', href: '/blog/' },
    { label: category, href: `/blog/categoria/${slugify(category)}/` },
  ]}
>
  <PageHeader eyebrow="Categoria" title={category} description={`${posts.length} ${posts.length === 1 ? 'publicação' : 'publicações'} nesta categoria.`} />
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post) => <BlogCard post={post} headingLevel="h2" />)}
  </div>
  <p class="mt-10"><a class="link" href={withBase('/blog/')}>Ver todas as publicações</a></p>
</BaseLayout>
